{
	frankenphp
}

{$SERVER_NAME} {
	encode zstd br gzip

	@laravel path /api /api/* /docs /docs/* /up
	handle @laravel {
		root * /app/public
		php_server
	}

	handle /assets/* {
		root * /srv/spa
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/spa
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
